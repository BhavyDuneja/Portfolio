# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-verification-code

# Microsoft Clarity (free heatmaps)
NEXT_PUBLIC_CLARITY_ID=your-clarity-id

# Facebook/Meta Pixel
NEXT_PUBLIC_FB_PIXEL_ID=your-pixel-id

# Contact Form (Gmail SMTP)
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password

# Zoho CRM (website leads → Zoho Leads). Self Client from https://api-console.zoho.in (or .com)
# ZOHO_DC: 'in' if your CRM is crm.zoho.in, 'com' for crm.zoho.com
ZOHO_DC=in
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
# Optional: must match a value in Zoho's Lead Source picklist (defaults to "Website Contact Form")
ZOHO_LEAD_SOURCE=Website Contact Form

# Supabase (Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
